# PULSE — Environment Variables Configuration
# Copy this file to .env and supply your API keys if LLM narrative synthesis is desired.
# Note: If no API key is provided, PULSE gracefully falls back to deterministic raw-signal passthrough.

# Free-Tier Default LLM Provider (Groq Cloud)
# Get a 100% free API key at: https://console.groq.com
GROQ_API_KEY=gsk_your_free_groq_api_key_here

# Optional: Anthropic Claude Provider
# Only required if params.yaml sets llm.provider to "anthropic"
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
